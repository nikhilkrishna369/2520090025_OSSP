#include <stdio.h>
#include <string.h>
int main() {
char buffer[100];
while (1) {
printf("> ");
fflush(stdout);
if (fgets(buffer, sizeof(buffer), stdin) == NULL)
break;
buffer[strcspn(buffer, "\n")] = '\0';
if (strcmp(buffer, "exit") == 0 ||
strcmp(buffer, "quit") == 0) {
printf("Exiting program...\n");
break;
}
if (strlen(buffer) == 0)
continue;
printf("Command received: %s\n", buffer);
}
return 0;
}
